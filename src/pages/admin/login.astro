---
import BaseLayoutNoHeader from '../../layouts/BaseLayoutNoHeader.astro';
---

<BaseLayoutNoHeader title="Admin Login" description="Access the admin panel">
  <div class="auth-page">
    <div class="auth-panel">
      <div class="auth-top">
        <a href="/" class="auth-logo">
          <img src="/logo.svg" alt="Secondary Yaza" />
        </a>
        <div class="auth-eyebrow">Access the admin panel</div>
        <h1 class="auth-title">Administrator login</h1>
        <p class="auth-sub">Manage content, uploads, and site settings.</p>
      </div>

      <form id="admin-login-form" class="auth-form">
        <div class="auth-field">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" placeholder="Enter admin username" required />
        </div>

        <div class="auth-field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Enter admin password" required />
        </div>

        <div class="auth-error" id="form-error" hidden></div>

        <button type="submit" class="auth-submit">Sign In as Admin</button>
      </form>

      <div class="auth-switch">
        <span>Back to user login</span>
        <a href="/login">Sign in</a>
      </div>
    </div>
  </div>

  <script>
    const adminLoginForm = document.getElementById('admin-login-form');
    const formError = document.getElementById('form-error');

    if (adminLoginForm) {
      adminLoginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        formError.hidden = true;

        const username = document.getElementById('username').value.trim();
        const password = document.getElementById('password').value;

        try {
          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          });

          const data = await res.json();

          if (data.success) {
            // Session cookie is set HttpOnly by the server — nothing to store here.
            window.location.href = '/admin';
          } else {
            formError.textContent = data.message || 'Sign in failed';
            formError.hidden = false;
          }
        } catch (error) {
          formError.textContent = 'Network error. Please try again.';
          formError.hidden = false;
        }
      });
    }
  </script>
</BaseLayoutNoHeader>
