---
import BaseLayoutNoHeader from '../layouts/BaseLayoutNoHeader.astro';
---

<BaseLayoutNoHeader title="Login" description="Sign in to your Secondary Yaza account">
  <div class="auth-page">
    <div class="auth-panel">
      <div class="auth-top">
        <a href="/" class="auth-logo">
          <img src="/logo.svg" alt="Secondary Yaza" />
        </a>
        <div class="auth-eyebrow">Sign in to your account</div>
        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-sub">Get back to your library, saved reads, and notes.</p>
      </div>

      <form id="login-form" class="auth-form">
        <div class="auth-field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="you@example.com" required />
        </div>

        <div class="auth-field">
          <label for="password">Password</label>
          <div class="password-wrap">
            <input type="password" id="password" name="password" autocomplete="current-password" placeholder="Enter your password" required />
            <button
              type="button"
              class="password-toggle"
              id="toggle-password"
              aria-label="Show password"
              aria-pressed="false"
            >
              <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true" style="display:none;">
                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 10 8 10 8a18.5 18.5 0 0 1-2.16 3.19"/>
                <path d="M6.61 6.61A18.5 18.5 0 0 0 2 12s3.5 7 10 7a9.12 9.12 0 0 0 5.39-1.61"/>
                <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>
                <line x1="2" y1="2" x2="22" y2="22"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="auth-error" id="form-error" hidden></div>

        <button type="submit" class="auth-submit">Sign In</button>
      </form>

      <div class="auth-switch">
        <span>Don't have an account?</span>
        <a href="/register">Create one</a>
      </div>
    </div>
  </div>

  <script>
    const loginForm = document.getElementById('login-form');
    const formError = document.getElementById('form-error');

    // Password reveal toggle
    const toggleBtn = document.getElementById('toggle-password');
    const passwordInput = document.getElementById('password');

    if (toggleBtn && passwordInput) {
      const eyeOpen = toggleBtn.querySelector('.eye-open');
      const eyeClosed = toggleBtn.querySelector('.eye-closed');

      toggleBtn.addEventListener('click', () => {
        const revealing = passwordInput.type === 'password';
        passwordInput.type = revealing ? 'text' : 'password';
        toggleBtn.setAttribute('aria-label', revealing ? 'Hide password' : 'Show password');
        toggleBtn.setAttribute('aria-pressed', String(revealing));
        if (eyeOpen) eyeOpen.style.display = revealing ? 'none' : '';
        if (eyeClosed) eyeClosed.style.display = revealing ? '' : 'none';
      });
    }

    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        formError.hidden = true;

        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json();

          if (data.success) {
            // Session cookie is set HttpOnly by the server; JS cannot read it.
            window.location.href = '/library';
          } else {
            formError.textContent = data.message || 'Sign in failed';
            formError.hidden = false;
          }
        } catch (error) {
          formError.textContent = 'Network error. Please try again.';
          formError.hidden = false;
        }
      });
    }
  </script>
</BaseLayoutNoHeader>
