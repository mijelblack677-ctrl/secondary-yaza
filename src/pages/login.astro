---
import BaseLayoutNoHeader from '../layouts/BaseLayoutNoHeader.astro';
---

<BaseLayoutNoHeader title="Login" description="Sign in to your Secondary Yaza account">
  <div class="auth-page">
    <div class="auth-panel">
      <div class="auth-top">
        <a href="/" class="auth-logo">
          <img src="/logo.svg" alt="Secondary Yaza" />
        </a>
        <div class="auth-eyebrow">Sign in to your account</div>
        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-sub">Get back to your library, saved reads, and notes.</p>
      </div>

      <form id="login-form" class="auth-form">
        <div class="auth-field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="you@example.com" required />
        </div>

        <div class="auth-field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" autocomplete="current-password" placeholder="Enter your password" required />
        </div>

        <div class="auth-error" id="form-error" hidden></div>

        <button type="submit" class="auth-submit">Sign In</button>
      </form>

      <div class="auth-switch">
        <span>Don't have an account?</span>
        <a href="/register">Create one</a>
      </div>
    </div>
  </div>

  <script>
    const loginForm = document.getElementById('login-form');
    const formError = document.getElementById('form-error');

    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        formError.hidden = true;

        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json();

          if (data.success) {
            document.cookie = `token=${data.token}; path=/; max-age=2592000; SameSite=Lax`;
            window.location.href = '/library';
          } else {
            formError.textContent = data.message || 'Sign in failed';
            formError.hidden = false;
          }
        } catch (error) {
          formError.textContent = 'Network error. Please try again.';
          formError.hidden = false;
        }
      });
    }
  </script>
</BaseLayoutNoHeader>
