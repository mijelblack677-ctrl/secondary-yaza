---
import BaseLayout from '../layouts/BaseLayout.astro';
import { icons } from '../lib/icons';
---

<BaseLayout title="Library" description="Browse our collection of books and educational resources">
  <section class="container" style="padding: 3rem var(--page-x) 1.5rem; max-width: 1280px;">
    <div style="text-align: center; margin-bottom: 2.25rem;">
      <span class="badge" style="display: inline-block; margin-bottom: 1rem;">Digital Collection</span>
      <h1 style="margin-bottom: 0.5rem;">Library</h1>
      <p class="text-muted" style="max-width: 520px; margin: 0.5rem auto 0; font-family: var(--font-body); font-size: 17px;">
        Browse the collection of books and educational resources. Purchase premium titles to read instantly.
      </p>
    </div>

    <div id="library-filters" style="display: flex; gap: 0.75rem; margin-bottom: 1.75rem; flex-wrap: wrap; justify-content: center;">
      <select id="category-filter" class="form-input" style="flex: 0 1 240px; min-width: 180px;">
        <option value="all">All Categories</option>
      </select>
      <select id="type-filter" class="form-input" style="flex: 0 0 auto; min-width: 150px;">
        <option value="all">All Types</option>
        <option value="book">Books</option>
        <option value="video">Videos</option>
        <option value="audio">Audio</option>
      </select>
    </div>

    <div id="loading" class="loading">
      <div class="spinner"></div>
      <p class="text-muted">Loading…</p>
    </div>

    <div id="library-grid" style="display: none; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1.25rem;"></div>

    <div id="empty-state" class="empty-state" style="display: none;">
      <div class="icon" set:html={icons.inbox}></div>
      <h3>No resources found</h3>
      <p>Try adjusting your filters or check back later for new content.</p>
    </div>

    <div id="library-gate" style="display: none;"></div>
  </section>

  <script>
    import { icon, icons } from '../lib/icons';
    import { accessGateFromResponse, joinHref, loginHref, renderAccessGate } from '../lib/accessGate';

    document.addEventListener('DOMContentLoaded', async () => {
      const grid = document.getElementById<HTMLDivElement>('library-grid');
      const loading = document.getElementById<HTMLDivElement>('loading');
      const emptyState = document.getElementById<HTMLDivElement>('empty-state');
      const categoryFilter = document.getElementById<HTMLSelectElement>('category-filter');
      const typeFilter = document.getElementById<HTMLSelectElement>('type-filter');
      const gateBox = document.getElementById<HTMLDivElement>('library-gate');
      const filters = document.getElementById<HTMLDivElement>('library-filters');

      // Auth is carried by the HttpOnly session cookie (credentials: 'same-origin').
      // The client never reads the token — it was removed from JS-reachable storage.
      let isAuthenticated = false;

      async function fetchLibrary() {
        loading.style.display = 'flex';
        grid.style.display = 'none';
        emptyState.style.display = 'none';
        gateBox.style.display = 'none';

        try {
          const params = new URLSearchParams({
            category: categoryFilter.value,
            type: typeFilter.value,
          });


          const res = await fetch(`/api/content/library?${params}`, { credentials: 'same-origin' });
          const data = await res.json().catch(() => null);

          if (data && data.success) {
            isAuthenticated = Boolean(data.isAuthenticated);
            renderLibrary(data.items, data.categories, data.isSubscribed);
            return;
          }

          // Membership is a gate, not a failure: tell the visitor which door to
          // use instead of reporting that the library would not load.
          const gate = accessGateFromResponse(res.status, data, '/library');
          if (gate) {
            showGate(gate);
            return;
          }

          showError((data && data.message) || 'We could not load the library just now.');
        } catch (error) {
          console.error('Error:', error);
          showError('Connection error');
        } finally {
          loading.style.display = 'none';
        }
      }

      function renderLibrary(items, categories, isSubscribed) {
        categoryFilter.innerHTML = '<option value="all">All Categories</option>';
        categories.forEach(cat => {
          const opt = document.createElement('option');
          opt.value = cat.id;
          opt.textContent = cat.name;
          categoryFilter.appendChild(opt);
        });

        if (items.length === 0) {
          emptyState.style.display = 'block';
          grid.style.display = 'none';
          return;
        }

        grid.style.display = 'grid';
        emptyState.style.display = 'none';
        grid.innerHTML = items.map(item => createBookCard(item, isSubscribed)).join('');
      }

      function createBookCard(item, isSubscribed) {
        const isOwned = item.isOwned || false;
        const isPremium = item.isPremium || false;
        const price = parseFloat(item.price || 0);

        const statusClass = isOwned ? 'owned' : isPremium ? 'premium' : 'available';
        const statusText = isOwned ? `${icon('check')} Owned` : isPremium ? `MWK ${price.toLocaleString()}` : 'Free';
        const canPurchase = isPremium && !isOwned && isSubscribed;

        return `
          <div class="book-card" data-id="${item.id}">
            <div class="book-cover">
              ${item.thumbnailUrl
                ? `<img src="${item.thumbnailUrl}" alt="${escapeHtml(item.title)}" class="book-cover-img" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"><span class="book-cover-icon" style="display:none;">${getBookIcon(item.contentType)}</span>`
                : `<span class="book-cover-icon">${getBookIcon(item.contentType)}</span>`
              }
              <div class="book-cover-overlay">
                <span class="btn">${isOwned ? 'Read Now' : canPurchase ? 'Purchase' : (isSubscribed ? 'Read Now' : 'View')}</span>
              </div>
            </div>
            <div class="book-info">
              <h3>${escapeHtml(item.title)}</h3>
              <p class="author">by ${escapeHtml(item.author || 'Unknown Author')}</p>
              <p class="description">${escapeHtml(item.description || 'No description available')}</p>
              <div class="book-meta">
                <span class="book-price ${!isPremium ? 'free' : ''}">
                  ${isPremium ? `MWK ${price.toLocaleString()}` : 'FREE'}
                </span>
                <span class="book-status ${statusClass}">${statusText}</span>
              </div>
              <div style="margin-top: 0.9rem; display: flex; gap: 0.5rem;">
                ${canPurchase
                  ? `<button class="btn purchase-btn" style="flex: 1;">Purchase</button>`
                  : `<a href="${isSubscribed || isOwned ? `/read/${item.id}` : '/login?redirect=/library'}" class="btn btn-outline" style="flex: 1;">${isOwned ? 'Read Now' : (isSubscribed ? 'Read Now' : 'View')}</a>`
                }
                ${isOwned && item.fileUrl && isAuthenticated && isSubscribed
                  ? `<a href="/api/content/read/${item.id}?download=1" class="btn btn-outline" style="flex: 0 0 auto;" download title="Download for offline reading">${icon('download')}</a>`
                  : ''
                }
              </div>
            </div>
          </div>
        `;
      }

      function getBookIcon(type) {
        const map = {
          book: 'bookOpen',
          video: 'video',
          audio: 'music',
          guide: 'file',
        };
        return icon(map[type] || 'file');
      }

      function escapeHtml(str: string) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      function showGate(gate) {
        filters.style.display = 'none';
        grid.style.display = 'none';
        emptyState.style.display = 'none';
        loading.style.display = 'none';
        gateBox.innerHTML = renderAccessGate(gate, { icons });
        gateBox.style.display = 'block';
      }

      function showError(message: string) {
        grid.style.display = 'none';
        emptyState.style.display = 'block';
        emptyState.querySelector('h3')!.textContent = 'Error loading library';
        emptyState.querySelector('p')!.textContent = message;
      }

      categoryFilter.addEventListener('change', fetchLibrary);
      typeFilter.addEventListener('change', fetchLibrary);

      grid.addEventListener('click', async (e: MouseEvent) => {
        const btn = (e.target as HTMLElement).closest('.purchase-btn');
        if (!btn) return;

        const card = btn.closest('.book-card')!;
        const contentId = card.dataset.id;
        const priceText = card.querySelector('.book-price')?.textContent || '0';
        const priceNum = parseInt(priceText.replace(/[^0-9]/g, '')) || 0;

        if (!isAuthenticated) {
          // Session ended since the page loaded — sign in and come back.
          window.location.href = loginHref('/library');
          return;
        }

        btn.textContent = 'Processing…';
        btn.disabled = true;

        try {
          const res = await fetch('/api/content/purchase', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ contentId, price: priceNum })
          });

          const data = await res.json();

          if (data.requiresPayment && data.checkoutUrl) {
            // Wallet could not cover it — hand the browser to PayChangu.
            window.location.href = data.checkoutUrl;
            return;
          }

          // A purchase that is refused for membership reasons gets the same
          // prompt as everything else, not a bare alert.
          const purchaseGate = accessGateFromResponse(res.status, data, '/library');
          if (purchaseGate) {
            showGate(purchaseGate);
            return;
          }

          if (data.success) {
            const statusEl = card.querySelector('.book-status');
            statusEl.innerHTML = `${icon('check')} Owned`;
            statusEl.className = 'book-status owned';

            const purchaseBtn = card.querySelector('.purchase-btn');
            if (purchaseBtn) {
              const newBtn = document.createElement('a');
              newBtn.href = `/read/${contentId}`;
              newBtn.className = 'btn btn-outline';
              newBtn.style.flex = '1';
              newBtn.textContent = 'Read Now';
              purchaseBtn.replaceWith(newBtn);
            }
            alert('Book purchased successfully!');
          } else {
            alert(data.message || 'Purchase failed');
          }
        } catch (error) {
          console.error('Purchase error:', error);
          alert('Purchase failed. Please try again.');
        } finally {
          if (!btn.disabled) {
            btn.textContent = 'Purchase';
          }
        }
      });

      fetchLibrary();
    });
  </script>
</BaseLayout>
