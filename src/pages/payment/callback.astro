---
import BaseLayoutNoHeader from '../../layouts/BaseLayoutNoHeader.astro';
---

<BaseLayoutNoHeader title="Payment status" description="Complete your Secondary Yaza payment">
  <div class="auth-page">
    <div class="auth-panel">
      <div class="auth-top">
        <a href="/" class="auth-logo">
          <img src="/logo.svg" alt="Secondary Yaza" />
        </a>
        <div class="auth-eyebrow">PayChangu payment</div>
        <h1 class="auth-title" id="callback-title">Confirming your payment…</h1>
        <p class="auth-sub" id="callback-sub">Please wait while we verify your payment with PayChangu.</p>
      </div>

      <div id="callback-status" style="font-family: var(--font-sans); font-size: 14px; padding: 1rem 1.1rem; border-radius: var(--radius-sm); background: var(--surface); border: 1px solid var(--line); margin-bottom: 1.25rem; text-align: center;">
        Verifying…
      </div>

      <div id="callback-actions" style="display: none; flex-direction: column; gap: 0.75rem;">
        <a href="/library" class="auth-submit" style="text-align: center; text-decoration: none;">Go to Library</a>
        <a href="/member-access" class="auth-switch" style="text-align: center;">View membership &amp; earnings</a>
      </div>

      <div id="retry-wrap" style="display: none; flex-direction: column; gap: 0.75rem;">
        <button type="button" class="auth-submit" id="retry-btn">Check payment again</button>
        <a href="/register" class="auth-switch" id="retry-back" style="text-align: center;">Back to registration</a>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const title = document.getElementById('callback-title');
      const sub = document.getElementById('callback-sub');
      const statusBox = document.getElementById('callback-status');
      const actions = document.getElementById('callback-actions');
      const retryWrap = document.getElementById('retry-wrap');
      const retryBtn = document.getElementById('retry-btn');

      const txRef = new URLSearchParams(window.location.search).get('tx_ref');
      const token = document.cookie.match(/token=([^;]+)/)?.[1];

      // Logged-out visitors came here from registration; logged-in ones from
      // a renewal or a book purchase.
      document.getElementById('retry-back').textContent = token ? 'Back to membership' : 'Back to registration';
      document.getElementById('retry-back').href = token ? '/member-access' : '/register';

      function render(state, message) {
        if (state === 'paid') {
          title.textContent = 'Payment confirmed';
          sub.textContent = 'Thank you — your payment has been received.';
          statusBox.textContent = message;
          statusBox.style.color = 'var(--success)';
          statusBox.style.borderColor = 'rgba(47, 122, 77, 0.35)';
          statusBox.style.background = 'rgba(47, 122, 77, 0.08)';
          actions.style.display = 'flex';
          retryWrap.style.display = 'none';
          return;
        }

        if (state === 'pending') {
          title.textContent = 'Payment still processing';
          sub.textContent = 'PayChangu has not confirmed the payment yet.';
          statusBox.textContent = message;
          statusBox.style.color = 'var(--ink-60)';
          retryWrap.style.display = 'flex';
          return;
        }

        title.textContent = 'Payment not completed';
        sub.textContent = 'You can try the payment again whenever you are ready.';
        statusBox.textContent = message;
        statusBox.style.color = 'var(--danger)';
        statusBox.style.borderColor = 'rgba(185, 28, 28, 0.3)';
        statusBox.style.background = 'rgba(185, 28, 28, 0.06)';
        retryWrap.style.display = 'flex';
      }

      async function verify() {
        if (!txRef) {
          render('failed', 'No payment reference was provided.');
          return;
        }

        statusBox.textContent = 'Verifying…';
        retryBtn.disabled = true;

        try {
          // A freshly-registered member is NOT signed in yet — their account
          // only gets a session token once the payment is confirmed. The
          // verify endpoint activates that pending account using the
          // unguessable tx_ref and returns the first token, so we must not
          // require a cookie here. Send the bearer token only if we have one.
          const headers = token ? { 'Authorization': 'Bearer ' + token } : {};
          const res = await fetch(`/api/payments/verify?tx_ref=${encodeURIComponent(txRef)}`, {
            headers,
          });
          const data = await res.json();

          if (data.success && data.status === 'paid') {
            if (data.token) {
              // This payment completed the registration: account is live now.
              document.cookie = `token=${data.token}; path=/; max-age=2592000; SameSite=Lax`;
              window.location.href = data.redirectTo || '/library';
              return;
            }
            const isSubscription = data.paymentType === 'subscription';
            render(
              'paid',
              isSubscription
                ? 'Your membership is now active.'
                : 'Your book is now in your library.'
            );
          } else if (data.status === 'pending') {
            render('pending', data.message || 'Still processing — try again shortly.');
          } else {
            render('failed', data.message || 'The payment could not be confirmed.');
          }
        } catch (error) {
          render('pending', 'Network problem while verifying. Please try again.');
        } finally {
          retryBtn.disabled = false;
        }
      }

      retryBtn.addEventListener('click', verify);
      verify();
    })();
  </script>
</BaseLayoutNoHeader>
