---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Policies" description="Terms of Service and Privacy Policy governing the use of Secondary Yaza.">
  <section class="container" style="padding: 3rem 1.25rem 2rem; max-width: 960px;">
    <div class="site-header" style="border-bottom: 1px solid var(--line-strong); padding: 1rem 0; margin-bottom: 2rem;">
      <div class="site-header-inner" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;">
        <div style="display:flex;align-items:center;gap:.75rem;">
          <a href="/" class="site-logo" aria-label="Secondary Yaza home" style="display:inline-flex;">
            <img src="/logo.svg" alt="Secondary Yaza" style="height:34px;display:inline-block;vertical-align:middle;" />
          </a>
          <span style="font-size:22px;letter-spacing:.16em;text-transform:uppercase;color:#121212;font-weight:600;">Policies</span>
        </div>
        <div style="text-align:right;">
          <a href="/library" style="font-size:13px;color:#fff;text-decoration:none;opacity:.75;">Back to Library</a>
        </div>
      </div>
    </div>

    <div class="site-main" style="padding-top:0;">
      <div style="max-width:760px;margin:0 auto;">
        <div style="margin-bottom:.5rem;">
          <h1 style="font-family:var(--font-serif);font-size:30px;line-height:1.1;margin:0 0 .75rem;">Terms of Service &amp; Privacy Policy</h1>
          <p style="color:var(--ink-40);font-size:14px;max-width:70ch;margin:0;">Last updated: 2026-10-10 · Secondary Yaza ("we", "our", "us") operates <span class="site-main" style="font-family:var(--font-serif);font-size:16px;color:var(--ink);">Secondary Yaza</span> (the "Service").</p>
        </div>

        <section style="margin-top:.75rem;">
          <h2 style="font-family:var(--font-serif);font-size:22px;letter-spacing:.02em;margin:1.25rem 0 .75rem;font-weight:400;">1. Terms of Service</h2>
          <p style="color:var(--ink-60);font-size:16px;line-height:1.75;margin:0 0 1rem;">By accessing or using Secondary Yaza, you agree to these terms. If you do not agree, do not use the Service.</p>
          <p style="color:var(--ink-60);font-size:16px;line-height:1.75;margin:0 0 1rem;">We reserve the right to change these terms at any time. Continued use of the Service after changes constitutes acceptance.</p>

          <h2 style="font-family:var(--font-serif);font-size:22px;letter-spacing:.02em;margin:1.25rem 0 .75rem;font-weight:400;">2. Privacy Policy</h2>
          <p style="color:var(--ink-60);font-size:16px;line-height:1.75;margin:0 0 1rem;">We collect personal information you provide when registering, such as your name, email, phone number, and password. Your data is used to provide the library, manage your account, and process purchases. We do not sell your personal data.</p>
          <p style="color:var(--ink-60);font-size:16px;line-height:1.75;margin:0 0 1rem;">You may request access to or deletion of your data at any time by contacting us.</p>
        </section>

        <section style="margin-top:.75rem;">
          <h2 style="font-family:var(--font-serif);font-size:22px;letter-spacing:.02em;margin:1.25rem 0 .75rem;font-weight:400;">3. Purchases &amp; Refund Policy</h2>
          <p style="color:var(--ink-60);font-size:16px;line-height:1.75;margin:0 0 1rem;">Secondary Yaza offers books and resources. Premium content may be available for a fee.</p>
          <p style="color:var(--ink-60);font-size:16px;line-height:1.75;margin:0 0 1rem;"><strong>There is no refund once a book is purchased.</strong></p>
          <p style="color:var(--ink-60);font-size:16px;line-height:1.75;margin:0 0 1rem;">Please review the content before purchasing. We do not offer refunds or exchanges for digital purchases.</p>
        </section>

        <section style="margin-top:.75rem;">
          <h2 style="font-family:var(--font-serif);font-size:22px;letter-spacing:.02em;margin:1.25rem 0 .75rem;font-weight:400;">4. Contact</h2>
          <p style="color:var(--ink-60);font-size:16px;line-height:1.75;margin:0 0 1rem;">If you have questions about these policies, contact us at <a href="mailto:support@secondaryyaza.com" style="color:#2458a8;text-decoration:underline;">support@secondaryyaza.com</a>.</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
