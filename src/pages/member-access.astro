---
import BaseLayout from '../layouts/BaseLayout.astro';
import { icons } from '../lib/icons';
import { getAuthUser } from '@lib/auth';
import { makeGate, renderAccessGate } from '@lib/accessGate';

// Signed-in only. Decided here so a logged-out visitor gets a way in rather
// than a failed fetch and a sign-out link.
const visitor = await getAuthUser(Astro.request);
const gate = visitor ? null : makeGate('login', '/member-access');

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Member Access — read the membership collection' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="container" style="padding: 3rem var(--page-x) 1.5rem; max-width: 1080px;">
    <div style="text-align: center; margin-bottom: 2.25rem;">
      <span class="badge" style="display: inline-block; margin-bottom: 1rem;">Member Access</span>
      <h1 style="margin-bottom: 0.5rem;">Your membership</h1>
      <p class="text-muted" style="max-width: 560px; margin: 0.5rem auto 0; font-family: var(--font-body); font-size: 17px;">
        Members pay MWK 2,000 to unlock the cheap membership collection. Use the referral code you were given to invite friends — each
        successful registration earns you MWK 500, and each book your invitee buys earns you another MWK 500.
      </p>
    </div>

    {gate
      ? <div set:html={renderAccessGate(gate, { icons, backHref: '/library', backLabel: 'Browse the library' })} />
      : <div id="loading" class="loading">
          <div class="spinner"></div>
          <p class="text-muted">Loading your membership…</p>
        </div>}

    <div id="member-panel" style="display: none;" data-gated={gate ? 'true' : 'false'}>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 1.75rem;">
        <div class="book-card" style="flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden;">
          <div class="book-cover" style="position: relative; aspect-ratio: 3/4; background: linear-gradient(160deg, var(--accent) 0%, var(--surface-2) 100%); display: flex; align-items: center; justify-content: center; overflow: hidden;">
            <span class="book-cover-icon" style="font-size: 2.25rem; opacity: 0.75;" set:html={icons.card}></span>
          </div>
          <div class="book-info" style="padding: 1rem 1.1rem 1.25rem; display: flex; flex-direction: column; flex: 1;">
            <h3 style="font-size: 1.15rem; margin-bottom: 0.25rem;">Membership</h3>
            <p class="author" style="font-family: var(--font-sans); font-size: 12px; color: var(--ink-40); margin-bottom: 0.6rem;">Member subscription</p>
            <div class="book-meta" style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--line);">
              <span class="book-price" style="font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: var(--ink);">MWK 2,000 / month</span>
              <span class="book-status" style="font-family: var(--font-sans); font-size: 10.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.25rem 0.55rem; border-radius: var(--radius-pill); background: rgba(47, 122, 77, 0.12); color: var(--success);" id="member-status">Not a member yet</span>
            </div>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 1.25rem;">
            <p style="font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-30); margin-bottom: 0.6rem;">Referral balance</p>
            <p style="font-family: var(--font-display); font-weight: 300; font-size: 2rem; line-height: 1; margin-bottom: 0.25rem;" id="referral-balance">MWK 0</p>
            <p style="font-size: 12px; color: var(--ink-40);">Earned from referrals and book purchases.</p>
          </div>

          <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 1.25rem;">
            <p style="font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-30); margin-bottom: 0.6rem;">Active referrals</p>
            <p id="referral-count" style="font-family: var(--font-display); font-weight: 300; font-size: 2rem; line-height: 1; margin-bottom: 0.25rem;">0</p>
            <p style="font-size: 12px; color: var(--ink-40);">People who registered using your code.</p>
          </div>

          <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 1.25rem;">
            <p style="font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-30); margin-bottom: 0.6rem;">Your referral link</p>
            <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.6rem;">
              <code id="referral-code" style="font-family: monospace; font-size: 15px; font-weight: 600; letter-spacing: 0.08em; color: var(--ink); background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.45rem 0.7rem; flex: 1; text-align: center; overflow-x: auto; white-space: nowrap;">—</code>
              <button type="button" id="referral-code-copy" class="btn-gold" style="font-size: 12px; padding: 0.45rem 0.8rem; white-space: nowrap;">Copy code</button>
            </div>
            <input type="text" id="referral-link" readonly value="" aria-label="Your referral invite link" style="width: 100%; box-sizing: border-box; font-family: var(--font-sans); font-size: 12.5px; color: var(--ink-60); background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.5rem 0.6rem; margin-bottom: 0.5rem;" />
            <button type="button" id="referral-link-copy" class="btn-gold" style="font-size: 12px; padding: 0.45rem 0.8rem; width: 100%;">Copy invite link</button>
            <p id="referral-copy-status" style="font-size: 12px; color: var(--success); margin-top: 0.5rem; display: none;"></p>
            <p style="font-size: 12px; color: var(--ink-40); margin-top: 0.5rem;">Share this link — when your friend opens it, your code is filled in for them automatically.</p>
          </div>
        </div>
      </div>

      <div id="join-wrap" style="display: none; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.75rem; margin-bottom: 1.75rem; text-align: center;">
        <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Become a member</h2>
        <p class="text-muted" style="font-size: 14px; margin: 0 auto 1rem; max-width: 520px;">
          Pay the MWK 2,000 subscription fee to unlock the membership collection of cheap books.
          Payment is processed securely by PayChangu.
        </p>
        <button type="button" class="auth-submit" id="join-btn" style="max-width: 320px; margin: 0 auto;">Pay MWK 2,000</button>
        <p class="auth-error" id="join-error" hidden style="background: rgba(185, 28, 28, 0.08); color: var(--danger); border: 1px solid rgba(185, 28, 28, 0.2); border-radius: var(--radius-sm); padding: 0.7rem 0.85rem; font-family: var(--font-sans); font-size: 13px; margin-top: 1rem;"></p>
      </div>

      <div id="payout-card" style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.75rem; margin-bottom: 1.75rem;">
        <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Payout number</h2>
        <p class="text-muted" style="font-size: 14px; margin: 0 0 0.9rem;">
          Withdrawals are sent to your mobile money wallet. Changing the number needs your password.
        </p>
        <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.35rem;">
          <span style="font-family: var(--font-sans); font-size: 15px; font-weight: 600; color: var(--ink);" id="payout-current">—</span>
          <span id="payout-operator" style="font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.2rem 0.5rem; border-radius: var(--radius-pill); background: var(--surface-2); color: var(--ink-60);"></span>
        </div>
        <details id="payout-edit" style="margin-top: 0.75rem;">
          <summary style="cursor: pointer; font-family: var(--font-sans); font-size: 13px; color: var(--ink-60);">Change payout number</summary>
          <form id="payout-form" style="display: flex; flex-direction: column; gap: 0.85rem; margin-top: 1rem;">
            <div class="auth-field" style="display: flex; flex-direction: column; gap: 0.4rem;">
              <label for="payout-phone" style="font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; color: var(--ink);">Mobile money number</label>
              <input type="tel" id="payout-phone" autocomplete="tel" placeholder="0991234567" style="font-family: var(--font-sans); font-size: 16px; color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 0.75rem 0.85rem;" />
              <div class="auth-hint">Airtel Money (098 / 099) or TNM Mpamba (088 / 089).</div>
            </div>
            <div class="auth-field" style="display: flex; flex-direction: column; gap: 0.4rem;">
              <label for="payout-password" style="font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; color: var(--ink);">Confirm with your password</label>
              <input type="password" id="payout-password" autocomplete="current-password" placeholder="Your account password" style="font-family: var(--font-sans); font-size: 16px; color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 0.75rem 0.85rem;" />
            </div>
            <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
              <button type="submit" class="auth-submit" id="payout-save" style="max-width: 230px; margin: 0;">Save payout number</button>
              <button type="button" class="btn-gold" id="payout-reset">Use my account number</button>
            </div>
            <p class="auth-error" id="payout-error" hidden style="background: rgba(185, 28, 28, 0.08); color: var(--danger); border: 1px solid rgba(185, 28, 28, 0.2); border-radius: var(--radius-sm); padding: 0.7rem 0.85rem; font-family: var(--font-sans); font-size: 13px;"></p>
            <p id="payout-status" style="font-size: 13px; color: var(--success); display: none;"></p>
          </form>
        </details>
      </div>

      <form id="withdraw-form" style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.75rem; display: flex; flex-direction: column; gap: 1.05rem;">
        <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Withdraw your earnings</h2>
        <p class="text-muted" style="font-size: 14px; margin: 0 0 1rem;">
          Earn MWK 500 per invited registrant and MWK 500 per book your invitee buys — withdraw to mobile money anytime.
          A <strong><span id="fee-rate">16</span>% fee</strong> is deducted from the amount you request.
        </p>
        <div class="auth-field" style="display: flex; flex-direction: column; gap: 0.4rem;">
          <label for="withdraw-amount" style="font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; color: var(--ink);">Amount to withdraw (MWK)</label>
          <input type="number" id="withdraw-amount" min="500" step="500" placeholder="e.g. 500" autocomplete="off" style="font-family: var(--font-sans); font-size: 16px; color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 0.75rem 0.85rem;" />
        </div>
        <div id="withdraw-breakdown" style="display: none; background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.85rem 0.95rem; font-family: var(--font-sans); font-size: 13px; color: var(--ink-60);">
          <div style="display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.35rem;"><span>You request</span><span id="bd-gross" style="color: var(--ink); font-weight: 600;">MWK 0</span></div>
          <div style="display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.35rem;"><span>Withdrawal fee (<span id="bd-rate">16</span>%)</span><span id="bd-fee" style="color: var(--ink); font-weight: 600;">MWK 0</span></div>
          <div style="display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--line); padding-top: 0.4rem;"><span style="color: var(--ink); font-weight: 600;">Sending to your phone</span><span id="bd-net" style="color: var(--ink); font-weight: 700;">MWK 0</span></div>
        </div>
        <div class="auth-field" style="display: flex; flex-direction: column; gap: 0.4rem;">
          <label for="withdraw-password" style="font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; color: var(--ink);">Confirm with your password</label>
          <input type="password" id="withdraw-password" autocomplete="current-password" placeholder="Your account password" style="font-family: var(--font-sans); font-size: 16px; color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 0.75rem 0.85rem;" />
        </div>
        <button type="submit" class="auth-submit" id="withdraw-btn">Withdraw MWK</button>
        <p class="auth-error" id="withdraw-error" hidden style="background: rgba(185, 28, 28, 0.08); color: var(--danger); border: 1px solid rgba(185, 28, 28, 0.2); border-radius: var(--radius-sm); padding: 0.7rem 0.85rem; font-family: var(--font-sans); font-size: 13px;"></p>
        <p id="withdraw-status" style="font-size: 13px; color: var(--success); display: none;"></p>
      </form>

      <div id="payout-history-wrap" style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.75rem; margin-top: 1.75rem;">
        <h2 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Recent withdrawals</h2>
        <div id="payout-history"><p class="text-muted" style="font-size: 13.5px;">No withdrawals yet.</p></div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ icons }}>
    const ICONS = icons;
    (async () => {
      // Auth is carried by the HttpOnly session cookie; client never reads tokens.
      const memberPanel = document.getElementById('member-panel');

      // The server already answered with a sign-in prompt.
      if (memberPanel && memberPanel.dataset.gated === 'true') return;

      const loading = document.getElementById('loading');
      const memberStatus = document.getElementById('member-status');
      const referralBalance = document.getElementById('referral-balance');
      const referralCount = document.getElementById('referral-count');
      const withdrawForm = document.getElementById('withdraw-form');
      const withdrawBtn = document.getElementById('withdraw-btn');
      const withdrawError = document.getElementById('withdraw-error');
      const withdrawStatus = document.getElementById('withdraw-status');

      try {
        const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
        const data = await res.json();

        if (!data.success) {
          // A session that ended between the page load and this fetch still
          // means "sign in again", not "your account is broken".
          const signedOut = res.status === 401;
          memberPanel.innerHTML = `
            <div style="text-align: center; padding: 3rem; background: white; border-radius: 8px; border: 1px solid var(--line);">
              <div style="font-size: 2.5rem; margin-bottom: 1rem;">${signedOut ? ICONS.lock : ICONS.alert}</div>
              <h2 style="margin-bottom: 0.5rem; font-family: var(--font-serif-display); font-weight: 300;">${signedOut ? 'Sign in to see your membership' : 'Unable to load account'}</h2>
              <p style="color: var(--ink-60); font-size: 0.9375rem; margin-bottom: 1rem;">${escapeHtml(signedOut ? 'Use the password for your account to continue.' : (data.message || 'Please try again.'))}</p>
              ${signedOut
                ? '<a href="/login?redirect=/member-access" class="btn-gold">Sign in</a>'
                : '<a href="/logout" class="btn-gold">Sign out</a>'}
            </div>
          `;
          memberPanel.style.display = 'block';
          return;
        }

        const user = data.user;
        const expiresAt = user.subscriptionExpiresAt ? new Date(user.subscriptionExpiresAt) : null;
        const activeMember = Boolean(user.isSubscribed) && (!expiresAt || expiresAt.getTime() > Date.now());
        memberStatus.textContent = activeMember ? 'Member' : (user.isSubscribed ? 'Membership expired' : 'Not a member yet');
        memberStatus.className = 'book-status ' + (activeMember ? 'owned' : 'available');
        referralBalance.textContent = 'MWK ' + (parseFloat(user.walletBalance || '0') || 0).toLocaleString();
        referralCount.textContent = user.referralCount ?? 0;

        // Referral sharing: surface the member's own code and a ready-made
        // invite link (/register?ref=CODE) they can send to a friend.
        const codeEl = document.getElementById('referral-code');
        const linkEl = document.getElementById('referral-link');
        const codeCopyBtn = document.getElementById('referral-code-copy');
        const linkCopyBtn = document.getElementById('referral-link-copy');
        const copyStatus = document.getElementById('referral-copy-status');
        const refCode = String(user.referralCode || '').trim();

        if (refCode) {
          const inviteUrl = new URL('/register', window.location.origin);
          inviteUrl.searchParams.set('ref', refCode);
          if (codeEl) codeEl.textContent = refCode;
          if (linkEl) linkEl.value = inviteUrl.toString();
        } else if (codeEl) {
          codeEl.textContent = 'Not available';
        }

        async function copyText(text, label) {
          if (!text) return;
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(text);
            } else {
              // Fallback for non-secure contexts.
              const ta = document.createElement('textarea');
              ta.value = text;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }
            if (copyStatus) {
              copyStatus.textContent = label + ' copied';
              copyStatus.style.display = 'block';
              setTimeout(() => { copyStatus.style.display = 'none'; }, 2000);
            }
          } catch (err) {
            if (copyStatus) {
              copyStatus.textContent = 'Could not copy — please select and copy manually.';
              copyStatus.style.display = 'block';
            }
          }
        }

        if (codeCopyBtn) codeCopyBtn.addEventListener('click', () => copyText(refCode, 'Referral code'));
        if (linkCopyBtn) linkCopyBtn.addEventListener('click', () => copyText(linkEl ? linkEl.value : '', 'Invite link'));

        if (activeMember) {
          const now = new Date();
          const expires = expiresAt || now;
          const days = Math.ceil((expires.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
          memberPanel.querySelector('.text-muted')?.remove();
          const p = document.createElement('p');
          p.className = 'text-muted';
          p.style.fontSize = '14px';
          p.style.margin = '0.5rem auto 0';
          p.style.maxWidth = '560px';
          p.style.fontFamily = 'var(--font-body)';
          p.textContent = `Your membership is active until ${expires.toLocaleDateString()}.`;
          memberPanel.prepend(p);
        }

        memberPanel.style.display = 'block';
        loading.style.display = 'none';

        // Membership payable via PayChangu when not (or no longer) active.
        const joinWrap = document.getElementById('join-wrap');
        const joinBtn = document.getElementById('join-btn');
        const joinError = document.getElementById('join-error');
        if (!activeMember && joinWrap && joinBtn) {
          joinWrap.style.display = 'block';
          joinBtn.addEventListener('click', async () => {
            joinError.hidden = true;
            joinBtn.disabled = true;
            joinBtn.textContent = 'Starting payment…';
            try {
              const res = await fetch('/api/payments/create', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ type: 'subscription' })
              });
              const result = await res.json();
              if (result.success && result.checkoutUrl) {
                window.location.href = result.checkoutUrl;
                return;
              }
              joinError.textContent = result.message || 'Could not start the payment. Please try again.';
              joinError.hidden = false;
            } catch (error) {
              joinError.textContent = 'Network error. Please try again.';
              joinError.hidden = false;
            } finally {
              joinBtn.disabled = false;
              joinBtn.textContent = 'Pay MWK 2,000';
            }
          });
        }

        // ---- Withdrawals: fee schedule, payout number, history ----
        const payoutForm = document.getElementById('payout-form');
        const payoutError = document.getElementById('payout-error');
        const payoutStatus = document.getElementById('payout-status');
        const amountInput = document.getElementById('withdraw-amount');
        const breakdownBox = document.getElementById('withdraw-breakdown');
        const historyBox = document.getElementById('payout-history');

        let withdrawConfig = { feeRate: 0.16, feePercent: 16, minWithdrawal: 500, step: 500 };

        const money = (n) => 'MWK ' + (Number(n) || 0).toLocaleString(undefined, { maximumFractionDigits: 2 });

        const payoutTone = (status) => {
          if (status === 'success') return { bg: 'rgba(47, 122, 77, 0.12)', fg: 'var(--success)', label: 'Sent' };
          if (status === 'reversed') return { bg: 'rgba(185, 28, 28, 0.10)', fg: 'var(--danger)', label: 'Refunded' };
          return { bg: 'var(--surface-2)', fg: 'var(--ink-60)', label: 'Processing' };
        };

        function renderBreakdown() {
          if (!breakdownBox || !amountInput) return;
          const amount = parseInt(amountInput.value || '0', 10) || 0;
          if (!amount) { breakdownBox.style.display = 'none'; return; }
          const fee = Math.round(amount * withdrawConfig.feeRate * 100) / 100;
          const net = Math.round((amount - fee) * 100) / 100;
          document.getElementById('bd-gross').textContent = money(amount);
          document.getElementById('bd-fee').textContent = money(fee);
          document.getElementById('bd-net').textContent = money(net);
          breakdownBox.style.display = 'block';
        }

        function renderHistory(list) {
          if (!historyBox) return;
          if (!list || list.length === 0) {
            historyBox.innerHTML = '<p class="text-muted" style="font-size: 13.5px;">No withdrawals yet.</p>';
            return;
          }
          historyBox.innerHTML = list.map((row) => {
            const tone = payoutTone(row.status);
            const when = row.createdAt ? new Date(row.createdAt).toLocaleDateString() : '';
            const note = row.status === 'reversed'
              ? '<p style="font-size: 12px; color: var(--ink-40); margin-top: 0.3rem;">Returned to your wallet' + (row.failureReason ? ': ' + escapeHtml(row.failureReason) : '') + '</p>'
              : '';
            return '<div style="display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; padding: 0.85rem 0; border-bottom: 1px solid var(--line);">'
              + '<div>'
              + '<p style="font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: var(--ink);">' + money(row.netAmount) + '</p>'
              + '<p style="font-size: 12.5px; color: var(--ink-40);">' + (row.operatorName ? escapeHtml(row.operatorName) + ' · ' : '') + escapeHtml(row.phone || '') + ' · ' + when + '</p>'
              + '<p style="font-size: 12px; color: var(--ink-40);">Requested ' + money(row.grossAmount) + ', fee ' + money(row.feeAmount) + '</p>'
              + note
              + '</div>'
              + '<span style="font-family: var(--font-sans); font-size: 10.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.25rem 0.55rem; border-radius: var(--radius-pill); background: ' + tone.bg + '; color: ' + tone.fg + '; white-space: nowrap;">' + tone.label + '</span>'
              + '</div>';
          }).join('');
        }

        async function loadPayouts() {
          try {
            const res = await fetch('/api/auth/payouts', { credentials: 'same-origin' });
            const data = await res.json();
            if (!data.success) return;

            withdrawConfig = {
              feeRate: data.feeRate ?? 0.16,
              feePercent: data.feePercent ?? 16,
              minWithdrawal: data.minWithdrawal ?? 500,
              step: data.step ?? 500
            };

            const rateEl = document.getElementById('fee-rate');
            const rateBd = document.getElementById('bd-rate');
            if (rateEl) rateEl.textContent = String(withdrawConfig.feePercent);
            if (rateBd) rateBd.textContent = String(withdrawConfig.feePercent);
            if (amountInput) {
              amountInput.min = String(withdrawConfig.minWithdrawal);
              amountInput.step = String(withdrawConfig.step);
            }

            const current = document.getElementById('payout-current');
            const operatorEl = document.getElementById('payout-operator');
            if (current) current.textContent = data.effectivePhone ? data.effectivePhone : 'Not set';
            if (operatorEl) operatorEl.textContent = data.operator || (data.payoutPhone ? '' : 'Account number');

            renderHistory(data.payouts || []);
          } catch (err) {
            console.warn('Could not load payouts:', err);
          }
        }

        if (amountInput) amountInput.addEventListener('input', renderBreakdown);

        async function savePayoutNumber(body, okText) {
          payoutError.hidden = true;
          payoutStatus.style.display = 'none';
          const saveBtn = document.getElementById('payout-save');
          if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Saving…'; }
          try {
            const res = await fetch('/api/auth/payout-phone', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body)
            });
            const result = await res.json();
            if (result.success) {
              payoutStatus.textContent = result.message || okText;
              payoutStatus.style.display = 'block';
              payoutForm?.reset();
              await loadPayouts();
              return true;
            }
            payoutError.textContent = result.message || 'Could not save your payout number';
            payoutError.hidden = false;
            return false;
          } catch (err) {
            payoutError.textContent = 'Network error. Please try again.';
            payoutError.hidden = false;
            return false;
          } finally {
            if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Save payout number'; }
          }
        }

        if (payoutForm) {
          payoutForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            await savePayoutNumber({
              phone: document.getElementById('payout-phone')?.value || '',
              password: document.getElementById('payout-password')?.value || ''
            }, 'Payout number saved');
          });
        }

        document.getElementById('payout-reset')?.addEventListener('click', async () => {
          const password = document.getElementById('payout-password')?.value || '';
          if (!password) {
            payoutError.textContent = 'Enter your password to confirm.';
            payoutError.hidden = false;
            return;
          }
          await savePayoutNumber({ reset: true, password }, 'Using your account number');
        });

        if (withdrawForm) {
          withdrawForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            withdrawError.hidden = true;
            withdrawStatus.style.display = 'none';

            const amount = parseInt(amountInput?.value || '0', 10);
            const password = document.getElementById('withdraw-password')?.value || '';
            const { minWithdrawal, step } = withdrawConfig;

            if (!amount || amount < minWithdrawal || amount % step !== 0) {
              withdrawError.textContent = 'Enter a valid amount (MWK ' + minWithdrawal + ' minimum, in ' + step + ' steps).';
              withdrawError.hidden = false;
              return;
            }
            if (!password) {
              withdrawError.textContent = 'Enter your password to confirm the withdrawal.';
              withdrawError.hidden = false;
              return;
            }

            withdrawBtn.disabled = true;
            withdrawBtn.textContent = 'Processing…';

            try {
              const res = await fetch('/api/auth/withdraw', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount, password })
              });
              const result = await res.json();
              if (result.success) {
                withdrawStatus.textContent = result.message;
                withdrawStatus.style.display = 'block';
                withdrawForm.reset();
                renderBreakdown();
                await loadPayouts();
              } else {
                withdrawError.textContent = result.message || 'Withdrawal failed';
                withdrawError.hidden = false;
              }
            } catch (error) {
              withdrawError.textContent = 'Withdrawal failed. Please try again.';
              withdrawError.hidden = false;
            } finally {
              withdrawBtn.disabled = false;
              withdrawBtn.textContent = 'Withdraw MWK';
            }
          });
        }

        await loadPayouts();
      } catch (error) {
        console.error('Member access load error:', error);
        loading.style.display = 'none';
        memberPanel.innerHTML = `
          <div style="text-align: center; padding: 3rem; background: white; border-radius: 8px; border: 1px solid var(--line);">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">${ICONS.alert}</div>
            <h2 style="margin-bottom: 0.5rem; font-family: var(--font-serif-display); font-weight: 300;">Something went wrong</h2>
            <p style="color: var(--ink-60); font-size: 0.9375rem; margin-bottom: 1rem;">Please refresh the page and try again.</p>
            <a href="/library" class="btn-gold">Back to Library</a>
          </div>
        `;
        memberPanel.style.display = 'block';
      }
    })();

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }
  </script>
</BaseLayout>
