---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { icons } from '../../lib/icons';
import { getAuthUser } from '@lib/auth';
import { loginHref, makeGate, renderAccessGate, safeNext } from '@lib/accessGate';

// The collection is members-only. Settle it here, on the server, so a visitor
// who cannot read yet is told how to get in instead of hitting an error after
// the page has already fetched something.
const visitor = await getAuthUser(Astro.request);
const expiresAt = visitor && visitor.subscriptionExpiresAt ? new Date(visitor.subscriptionExpiresAt) : null;
const isMember = Boolean(visitor && visitor.isSubscribed && expiresAt && expiresAt > new Date());
const nextPath = safeNext(`/read/${Astro.params.id}`);
const gate = visitor
  ? (isMember ? null : makeGate(expiresAt && expiresAt <= new Date() ? 'expired' : 'subscribe', nextPath))
  : makeGate('login', nextPath);

// The inline script cannot import, so it is handed the same panels the server
// renders. A membership that lapses mid-read then gets a way in, not an error.
const gateOptions = { icons, backHref: '/library', backLabel: 'Browse all books' };
const gatePrompts = {
  login_required: renderAccessGate(makeGate('login', nextPath), gateOptions),
  subscription_required: renderAccessGate(makeGate('subscribe', nextPath), gateOptions),
  subscription_expired: renderAccessGate(makeGate('expired', nextPath), gateOptions),
};
---

<BaseLayout title="Reading" description="Read a title from the Secondary Yaza collection.">
  <div class="reader-layout">
    <aside class="reader-sidebar">
      <div class="reader-sidebar-header">
        <div class="reader-sidebar-title"><span class="icon-inline" set:html={icons.book}></span> Your Library</div>
        <a href="/library" class="reader-sidebar-link">Browse All Books</a>
        <a href="/" class="reader-sidebar-link">Home</a>
        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
          {visitor
            ? <a href="/logout" class="reader-sidebar-link">Sign Out</a>
            : <a href={loginHref(nextPath)} class="reader-sidebar-link">Sign In</a>}
        </div>
      </div>
      <div id="reader-nav" style="font-family: var(--font-sans); font-size: 13px;">
        <p style="color: rgba(255,255,255,0.4); font-size: 12px;">{gate ? 'Members only' : 'Loading…'}</p>
      </div>
    </aside>

    <main class="reader-content" id="reader-content" data-gated={gate ? 'true' : 'false'}>
      {gate
        ? <div set:html={renderAccessGate(gate, { icons, backHref: '/library', backLabel: 'Browse all books' })} />
        : <div id="loading" class="loading">
            <div class="spinner"></div>
            <p class="text-muted">Loading book…</p>
          </div>}
    </main>
  </div>

  <script is:inline define:vars={{ icons, gatePrompts }}>
    const ICONS = icons;
    const GATE_PROMPTS = gatePrompts;

    // Client-side icon lookup with safe fallback (fixes "icon is not defined")
    function icon(name) {
      return ICONS[name] || ICONS.file || '';
    }

    document.addEventListener('DOMContentLoaded', async () => {
      const urlParams = new URLSearchParams(window.location.search);
      const bookId = urlParams.get('id') || document.location.pathname.split('/').pop();

      const readerContent = document.getElementById('reader-content');

      // The server already answered with a sign-in or join prompt.
      if (readerContent && readerContent.dataset.gated === 'true') return;

      const loading = document.getElementById('loading');

      if (!bookId) {
        readerContent.innerHTML = emptyState('bookOpen', 'Book Not Found', "The book you're looking for doesn't exist.");
        return;
      }

      try {
        // Session lives in an HttpOnly cookie now; fetch sends it with credentials.
        const authHeaders = {};
        const credOpts = { credentials: 'same-origin' };

        const metaRes = await fetch('/api/content/read/' + encodeURIComponent(bookId) + '?mode=meta', {
          headers: authHeaders, credentials: 'same-origin'
        });

        const metaData = await metaRes.json().catch(() => ({ success: false, message: 'Unreadable response from server' }));

        if (!metaData.success) {
          // Membership gate rather than a failure — show the prompt the server
          // prepared, so an expired session never reads as a broken book.
          if (metaData.code && GATE_PROMPTS[metaData.code]) {
            if (loading) loading.style.display = 'none';
            readerContent.innerHTML = GATE_PROMPTS[metaData.code];
            return;
          }
          // Premium book the reader has not paid for — offer the paywall here
          // too, so landing on this page directly is not a dead end.
          if (metaData.requiresPurchase) {
            renderPaywall(metaData);
            return;
          }
          readerContent.innerHTML = emptyState('alert', metaData.title || 'Unavailable', metaData.message || 'This title could not be opened right now.');
          return;
        }

        loading.style.display = 'none';

        const streamUrl = '/api/content/read/' + encodeURIComponent(bookId);
        const downloadUrl = streamUrl + '?download=1';
        const renderMode = metaData.renderMode || (metaData.textMode ? 'text' : 'download');

        if (renderMode === 'text') {
          const textRes = await fetch('/api/content/read/' + encodeURIComponent(bookId) + '?mode=text', {
            headers: authHeaders, credentials: 'same-origin'
          });
          const textData = await textRes.json();

          if (textData.success && textData.blocks) {
            renderTextContent(textData.blocks, metaData, downloadUrl);
          } else {
            readerContent.innerHTML = emptyState('file', 'Unable to Display Content', 'This book format is not supported for text viewing.');
          }
        } else if (renderMode === 'html') {
          const htmlRes = await fetch('/api/content/read/' + encodeURIComponent(bookId) + '?mode=html', {
            headers: authHeaders, credentials: 'same-origin'
          });
          const htmlData = await htmlRes.json().catch(() => ({ success: false }));

          if (htmlData.success && htmlData.html) {
            renderHtmlContent(htmlData.html, metaData, downloadUrl);
          } else {
            readerContent.innerHTML = renderDownload(metaData, downloadUrl);
          }
        } else if (renderMode === 'pdf') {
          readerContent.innerHTML = '<div class="reader-container">' + readerHeader(metaData, downloadUrl) + '<iframe class="reader-frame" src="' + streamUrl + '" title="' + escapeHtml(metaData.title) + '"></iframe></div>';
        } else {
          readerContent.innerHTML = renderDownload(metaData, downloadUrl);
        }

        const nav = document.getElementById('reader-nav');
        if (nav) {
          nav.innerHTML = '<p style="color: rgba(255,255,255,0.4); font-size: 12px; margin-top: 0.5rem;">Format: ' + escapeHtml(metaData.label) + ' | ' + (metaData.size ? (metaData.size / 1024 / 1024).toFixed(1) + ' MB' : 'Unknown') + '</p>';
        }

        document.title = metaData.title + ' | Secondary Yaza';
      } catch (error) {
        console.error('Reader error:', error);
        loading.style.display = 'none';
        readerContent.innerHTML = emptyState('alert', 'Error Loading Book', 'Something went wrong. Please try again.');
      }
    });

    function renderPaywall(meta) {
      const container = document.getElementById('reader-content');
      const loading = document.getElementById('loading');
      if (loading) loading.style.display = 'none';

      const price = parseFloat(meta.price || '0') || 0;
      const priceText = 'MWK ' + price.toLocaleString();

      container.innerHTML = '<div class="reader-container"><div class="reader-content-block" style="text-align:center; padding: 2.5rem 1.5rem;">'
        + '<div class="icon">' + icon('lock') + '</div>'
        + '<h1 style="margin-bottom: .5rem;">' + escapeHtml(meta.title || 'Premium book') + '</h1>'
        + '<p style="max-width: 46ch; margin: 0 auto 1rem;">This is a premium title. Pay ' + escapeHtml(priceText) + ' to unlock it on your account. Payment is processed securely by PayChangu.</p>'
        + '<button type="button" id="paywall-buy" class="btn btn-primary">Pay ' + escapeHtml(priceText) + '</button>'
        + '<p id="paywall-msg" style="margin-top: .75rem; font-size: 13px;"></p>'
        + '<p style="margin-top: .5rem;"><a href="/library" class="reader-sidebar-link" style="color: var(--ink-60);">Back to Library</a></p>'
        + '</div></div>';

      const btn = document.getElementById('paywall-buy');
      const msg = document.getElementById('paywall-msg');

      btn.addEventListener('click', async function () {
        btn.disabled = true;
        btn.textContent = 'Starting payment\u2026';
        if (msg) msg.textContent = '';

        try {
          const res = await fetch('/api/content/purchase', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contentId: meta.contentId })
          });
          const data = await res.json();

          // Wallet could not cover it — hand the browser to PayChangu.
          if (data.requiresPayment && data.checkoutUrl) {
            window.location.href = data.checkoutUrl;
            return;
          }
          if (data.success) {
            window.location.reload();
            return;
          }
          if (msg) msg.textContent = data.message || 'Could not start the payment. Please try again.';
        } catch (err) {
          if (msg) msg.textContent = 'Network error. Please try again.';
        } finally {
          btn.disabled = false;
          btn.textContent = 'Pay ' + priceText;
        }
      });
    }

    function emptyState(iconName, title, message) {
      return '<div class="empty-state"><div class="icon">' + icon(iconName) + '</div><h3>' + escapeHtml(title) + '</h3><p>' + escapeHtml(message) + '</p><a href="/library" class="btn btn-primary" style="margin-top: 1rem;">Back to Library</a></div>';
    }

    function readerHeader(meta, downloadUrl) {
      const size = meta.size ? (meta.size / 1024 / 1024).toFixed(1) + ' MB' : '';
      return '<div class="reader-header"><h1 class="reader-title">' + escapeHtml(meta.title) + '</h1><p class="reader-author">by ' + escapeHtml(meta.author || 'Unknown Author') + '</p><div class="reader-toolbar"><span class="reader-meta">' + escapeHtml(meta.label) + (size ? ' · ' + size : '') + '</span><a class="btn" href="' + downloadUrl + '" download>' + icon('download') + ' Download for offline</a></div></div>';
    }

    function renderDownload(meta, downloadUrl) {
      return '<div class="reader-container">' + readerHeader(meta, downloadUrl) + '<div class="reader-content-block"><p>This title is a <strong>' + escapeHtml(meta.label) + '</strong> file, which can\'t be previewed in the browser. Download it to read offline with your device\'s document viewer.</p></div></div>';
    }

    function renderHtmlContent(html, meta, downloadUrl) {
      const container = document.getElementById('reader-content');
      const loading = document.getElementById('loading');

      loading.style.display = 'none';

      container.innerHTML = '<div class="reader-container">' + readerHeader(meta, downloadUrl) + '<div class="reader-article">' + html + '</div></div>';

      document.title = meta.title + ' | Secondary Yaza';
    }

    async function renderTextContent(blocks, meta, downloadUrl) {
      const container = document.getElementById('reader-content');
      const loading = document.getElementById('loading');

      loading.style.display = 'none';

      const html = blocks.map(function(block) {
        switch (block.type) {
          case 'h1':
            return '<h1>' + escapeHtml(block.text) + '</h1>';
          case 'h2':
            return '<h2>' + escapeHtml(block.text) + '</h2>';
          case 'h3':
            return '<h3>' + escapeHtml(block.text) + '</h3>';
          case 'quote':
            return '<blockquote>' + escapeHtml(block.text) + '</blockquote>';
          case 'li':
            return '<li>' + escapeHtml(block.text) + '</li>';
          case 'break':
            return '<br/>';
          default:
            return '<p>' + escapeHtml(block.text) + '</p>';
        }
      }).join('');

      container.innerHTML = '<div class="reader-container">' + readerHeader(meta, downloadUrl) + '<div class="reader-content-block">' + html + '</div></div>';

      document.title = meta.title + ' | Secondary Yaza';
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }
  </script>
</BaseLayout>
