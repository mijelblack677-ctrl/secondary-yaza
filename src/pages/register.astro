---
import BaseLayoutNoHeader from '../layouts/BaseLayoutNoHeader.astro';
---

<BaseLayoutNoHeader title="Register" description="Create your Secondary Yaza account">
  <div class="auth-page">
    <div class="auth-panel">
      <div class="auth-top">
        <a href="/" class="auth-logo">
          <img src="/logo.svg" alt="Secondary Yaza" />
        </a>
        <div class="auth-eyebrow">Join Secondary Yaza today</div>
        <h1 class="auth-title">Create your account</h1>
        <p class="auth-sub">Save books, pick up where you left off, and read anywhere.</p>
      </div>

      <form id="register-form" class="auth-form">
        <div class="auth-field">
          <label class="auth-check">
            <input type="checkbox" id="policies-check" required />
            <span>I agree to the <a href="/policies" target="_blank" rel="noopener">Terms of Service</a> and <a href="/policies" target="_blank" rel="noopener">Privacy Policy</a>.</span>
          </label>
        </div>

        <div class="auth-field">
          <label for="referralCode" style="font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; color: var(--ink);">Referral code (optional)</label>
          <input type="text" id="referralCode" name="referralCode" autocomplete="off" placeholder="Enter a friend's code to earn MWK 500" style="font-family: var(--font-sans); font-size: 16px; color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 0.75rem 0.85rem;" />
        </div>

        <div class="auth-field">
          <label for="fullName">Full name</label>
          <input type="text" id="fullName" name="fullName" autocomplete="name" placeholder="Enter your full name" required />
        </div>

        <div class="auth-field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="you@example.com" required />
        </div>

        <div class="auth-field">
          <label for="phone">Phone number</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+265 991 234 567" required />
        </div>

        <div class="auth-field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" autocomplete="new-password" placeholder="Create a strong password" required minlength="8" />
          <div class="auth-hint">Minimum 8 characters</div>
        </div>

        <div class="auth-field">
          <label for="confirmPassword">Confirm password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" placeholder="Confirm your password" required />
        </div>

        <div class="auth-field" style="border-top: 1px solid var(--line); padding-top: 1rem;">
          <p style="font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink); margin-bottom: 0.4rem;">Membership</p>
          <p style="font-size: 13px; color: var(--ink-60); line-height: 1.55;">
            Registration is completed with a membership fee of <strong>MWK 2,000</strong>, paid securely through PayChangu.
            Your account is created and activated <strong>only after the payment is confirmed</strong> — until then nothing is charged to you beyond the fee itself and no account exists.
            The membership unlocks the collection of cheap books for 30 days. There is no refund once a book is purchased.
          </p>
        </div>

        <div class="auth-error" id="form-error" hidden></div>

        <button type="submit" class="auth-submit">Create account &amp; pay MWK 2,000</button>

        <div class="auth-switch">
          <span>Already have an account?</span>
          <a href="/login">Sign in</a>
        </div>
      </form>
    </div>
  </div>

  <script>
    const registerForm = document.getElementById('register-form');
    const policiesCheck = document.getElementById('policies-check');
    const formError = document.getElementById('form-error');
    const referralField = document.getElementById('referralCode');

    // An invite link looks like /register?ref=ABC12345. When one is present the
    // code is filled in and locked, so the invited person cannot accidentally
    // change who referred them (the referrer still earns their bonus).
    const params = new URLSearchParams(window.location.search);
    const refFromLink = (params.get('ref') || params.get('code') || '').trim().toUpperCase();

    if (referralField && refFromLink) {
      referralField.value = refFromLink;
      referralField.readOnly = true;
      referralField.setAttribute('aria-readonly', 'true');
      referralField.style.background = 'var(--surface-2)';
      referralField.style.color = 'var(--ink-60)';
      referralField.style.cursor = 'not-allowed';

      const refLabel = document.querySelector('label[for="referralCode"]');
      if (refLabel) refLabel.textContent = 'Referral code (from your invite link)';

      if (!document.getElementById('referral-locked-note')) {
        const note = document.createElement('div');
        note.id = 'referral-locked-note';
        note.className = 'auth-hint';
        note.textContent = 'This code came from the person who invited you and cannot be changed.';
        referralField.insertAdjacentElement('afterend', note);
      }
    }

    if (registerForm) {
      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        formError.hidden = true;

        const fullName = document.getElementById('fullName').value.trim();
        const email = document.getElementById('email').value.trim();
        const phone = document.getElementById('phone').value.trim();
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const policiesAccepted = policiesCheck?.checked;
        const referralCode = (document.getElementById('referralCode')?.value || '').trim();

        if (password !== confirmPassword) {
          formError.textContent = 'Passwords do not match';
          formError.hidden = false;
          return;
        }

        if (!policiesAccepted) {
          formError.textContent = 'You must accept the Terms of Service and Privacy Policy before creating an account.';
          formError.hidden = false;
          return;
        }

        if (password.length < 8) {
          formError.textContent = 'Password must be at least 8 characters';
          formError.hidden = false;
          return;
        }

        try {
          const res = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fullName, email, phone, password, policiesAcceptedAt: new Date().toISOString(), referralCode })
          });

          const data = await res.json();

          if (data.success) {
            if (data.activated) {
              // An earlier payment had already completed — account activated
              // and the HttpOnly session cookie was set server-side.
              window.location.href = data.redirectTo || '/library';
            } else if (data.checkoutUrl) {
              // The account is staged but inactive until PayChangu confirms the fee.
              window.location.href = data.checkoutUrl;
            } else {
              formError.textContent = 'Your registration is incomplete. Please try again.';
              formError.hidden = false;
            }
          } else {
            formError.textContent = data.message || 'Registration failed';
            formError.hidden = false;
          }
        } catch (error) {
          formError.textContent = 'Network error. Please try again.';
          formError.hidden = false;
        }
      });
    }
  </script>
</BaseLayoutNoHeader>
